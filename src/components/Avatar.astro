---
// Team/user avatar. Shows initials underneath, so a missing or broken image still looks fine.
interface Props {
  src: string | null;
  name: string;
  size?: number;
}
const { src, name, size = 36 } = Astro.props;
const initials = name.replace(/^team\s+/i, '').replace(/[^A-Za-z0-9 ]/g, '').split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0]).join('').toUpperCase() || '?';
---
<span class="avatar avatar-fallback" style={`width:${size}px;height:${size}px;font-size:${Math.round(size * 0.38)}px`} aria-hidden="true">
  {initials}
  {src && <img src={src} alt="" width={size} height={size} loading="lazy" onerror="this.remove()" />}
</span>
