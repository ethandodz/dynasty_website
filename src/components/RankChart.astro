---
// Small line chart of a team's power ranking over time (1 at the top).
interface Props {
  points: { label: string; rank: number }[];
  teams: number;
}
const { points, teams } = Astro.props;
const w = 320, h = 140, padX = 28, padY = 16;
const step = points.length > 1 ? (w - padX * 2) / (points.length - 1) : 0;
const x = (i: number) => (points.length > 1 ? padX + i * step : w / 2);
const y = (r: number) => padY + ((r - 1) / Math.max(teams - 1, 1)) * (h - padY * 2);
const d = points.map((p, i) => `${i ? 'L' : 'M'}${x(i).toFixed(1)},${y(p.rank).toFixed(1)}`).join(' ');
const ticks = [1, Math.ceil(teams / 2), teams];
---
<svg class="rank-chart" viewBox={`0 0 ${w} ${h + 18}`} role="img" aria-label={`Power ranking history: ${points.map((p) => `${p.label} #${p.rank}`).join(', ')}`}>
  {ticks.map((t) => (
    <g>
      <line x1={padX} x2={w - padX} y1={y(t)} y2={y(t)} class="grid" />
      <text x={padX - 8} y={y(t) + 4} text-anchor="end" class="tick">#{t}</text>
    </g>
  ))}
  {points.length > 1 && <path d={d} class="line" />}
  {points.map((p, i) => (
    <g>
      <circle cx={x(i)} cy={y(p.rank)} r="5" class="dot" />
      <text x={x(i)} y={y(p.rank) - 10} text-anchor="middle" class="val">#{p.rank}</text>
      <text x={x(i)} y={h + 12} text-anchor="middle" class="tick">{p.label}</text>
    </g>
  ))}
</svg>
